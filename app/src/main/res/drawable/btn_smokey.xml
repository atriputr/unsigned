<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Soft outer shadow simulation: slightly larger dark layer beneath -->
    <item android:left="4dp" android:right="-4dp" android:top="6dp" android:bottom="-4dp">
        <shape android:shape="rectangle">
            <solid android:color="#60100804" />
            <corners android:radius="50dp" />
        </shape>
    </item>

    <!-- 3D bottom-edge depth: dark strip peeking from the very bottom -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#A0150C04" />
            <corners android:radius="50dp" />
        </shape>
    </item>

    <!-- Main frosted body — darker brownish-gray gradient, raised 4dp -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#A0B59973"
                android:centerColor="#827B6149"
                android:endColor="#70412D19"
                android:type="linear" />
            <corners android:radius="50dp" />
        </shape>
    </item>

    <!-- Grain A: 45° warm shimmer -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#00FFFFFF"
                android:endColor="#18C5A97B"
                android:type="linear" />
            <corners android:radius="50dp" />
        </shape>
    </item>

    <!-- Grain B: 135° cross-grain -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#14A18361"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="50dp" />
        </shape>
    </item>

    <!-- Grain C: 315° fine warm grain -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#00E8D4B0"
                android:endColor="#10B99969"
                android:type="linear" />
            <corners android:radius="50dp" />
        </shape>
    </item>

    <!-- Grain D: horizontal frosted diffusion haze -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#08C1A979"
                android:centerColor="#12D9C199"
                android:endColor="#06B19161"
                android:type="linear" />
            <corners android:radius="50dp" />
        </shape>
    </item>

    <!-- Top specular: glass reflection streak (upper ~40%) -->
    <item
        android:top="3dp"
        android:bottom="30dp"
        android:left="14dp"
        android:right="14dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#38FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="50dp" />
        </shape>
    </item>

    <!-- Glass edge: warm dark-amber border -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1.2dp"
                android:color="#65C5A979" />
            <corners android:radius="50dp" />
        </shape>
    </item>

</layer-list>
